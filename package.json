{
  "name": "cflgateway",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx --env-file-if-exists=.env test/smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CFL Gateway API Server",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
